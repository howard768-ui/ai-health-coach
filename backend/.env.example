# Meld Backend — Environment Variables
# Copy to .env and fill in real values

# Database
DATABASE_URL=postgresql+asyncpg://meld:meld_dev_password@localhost:5432/meld

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Oura Ring API
OURA_CLIENT_ID=your_oura_client_id_here
OURA_CLIENT_SECRET=your_oura_secret_here
OURA_REDIRECT_URI=http://localhost:8000/api/auth/oura/callback

# App Config
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
